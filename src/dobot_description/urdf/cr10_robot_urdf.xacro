<?xml version="1.0"?>
<robot name="cr10_robot" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- 定义宏，供车体调用 -->
  <xacro:macro name="cr10_robot">

  <!-- 机械臂底座 -->
  <link name="arm_base_link">
    <inertial>
      <origin xyz="-0.0017435 -4.7141E-06 0.032774" rpy="0 0 0" />
      <mass value="1.8265" />
      <inertia ixx="0.0041731" ixy="5.9354E-07" ixz="2.52E-05" iyy="0.0043128" iyz="-5.4503E-07" izz="0.0067702" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://dobot_description/meshes/cr10/base_link.STL" />
      </geometry>
      <material name="White">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://dobot_description/meshes/cr10/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <!-- Joint1 -->
  <link name="Link1">
    <inertial>
      <origin xyz="-1.6635E-06 -0.010819 0.0028389" rpy="0 0 1.5708" />
      <mass value="4.1649" />
      <inertia ixx="0.020714" ixy="-1.9343E-07" ixz="1.6036E-07" iyy="0.018824" iyz="-9.6731E-05" izz="0.014575" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://dobot_description/meshes/cr10/Link1.STL" /></geometry>
      <material name="White"><color rgba="1 1 1 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://dobot_description/meshes/cr10/Link1.STL" /></geometry>
    </collision>
  </link>
  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0.1765" rpy="0 0 1.5708" />
    <parent link="arm_base_link" />
    <child link="Link1" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14" upper="3.14" effort="0" velocity="0" />
  </joint>

  <!-- Joint2 -->
  <link name="Link2">
    <inertial>
      <origin xyz="-0.24631 0 0.19515" rpy="0 0 0" />
      <mass value="11.314" />
      <inertia ixx="0.033616" ixy="-8.2998E-07" ixz="-0.0033352" iyy="0.30683" iyz="0" izz="0.29972" />
    </inertial>
    <visual><geometry><mesh filename="package://dobot_description/meshes/cr10/Link2.STL" /></geometry></visual>
    <collision><geometry><mesh filename="package://dobot_description/meshes/cr10/Link2.STL" /></geometry></collision>
  </link>
  <joint name="joint2" type="revolute">
    <origin xyz="0 0 0" rpy="1.5708 1.5708 0" />
    <parent link="Link1" />
    <child link="Link2" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14" upper="3.14" effort="0" velocity="0" />
  </joint>

  <!-- Joint3 -->
  <link name="Link3">
    <inertial>
      <origin xyz="-0.27085 0 0.0623" rpy="0 0 0" />
      <mass value="4.8919" />
      <inertia ixx="0.007157" ixy="0" ixz="-0.002577" iyy="0.23967" iyz="0" izz="0.23837" />
    </inertial>
    <visual><geometry><mesh filename="package://dobot_description/meshes/cr10/Link3.STL" /></geometry></visual>
    <collision><geometry><mesh filename="package://dobot_description/meshes/cr10/Link3.STL" /></geometry></collision>
  </link>
  <joint name="joint3" type="revolute">
    <origin xyz="-0.607 0 0" rpy="0 0 0" />
    <parent link="Link2" />
    <child link="Link3" />
    <axis xyz="0 0 1" />
    <limit lower="-2.861" upper="2.861" effort="0" velocity="0" />
  </joint>

  <!-- Joint4 -->
  <link name="Link4">
    <inertial>
      <origin xyz="0 0.00799 -0.00589" rpy="0 0 0" />
      <mass value="1.1688" />
      <inertia ixx="0.002926" ixy="0" ixz="0" iyy="0.001501" iyz="-0.000054" izz="0.002733" />
    </inertial>
    <visual><geometry><mesh filename="package://dobot_description/meshes/cr10/Link4.STL" /></geometry></visual>
    <collision><geometry><mesh filename="package://dobot_description/meshes/cr10/Link4.STL" /></geometry></collision>
  </link>
  <joint name="joint4" type="revolute">
    <origin xyz="-0.568 0 0.191" rpy="0 0 -1.5708" />
    <parent link="Link3" />
    <child link="Link4" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14" upper="3.14" effort="0" velocity="0" />
  </joint>

  <!-- Joint5 -->
  <link name="Link5">
    <inertial>
      <origin xyz="0 -0.01455 -0.00455" rpy="0 0 0" />
      <mass value="1.223" />
      <inertia ixx="0.003379" ixy="0" ixz="0" iyy="0.001493" iyz="0.000084" izz="0.003233" />
    </inertial>
    <visual><geometry><mesh filename="package://dobot_description/meshes/cr10/Link5.STL" /></geometry></visual>
    <collision><geometry><mesh filename="package://dobot_description/meshes/cr10/Link5.STL" /></geometry></collision>
  </link>
  <joint name="joint5" type="revolute">
    <origin xyz="0 -0.125 0" rpy="1.5708 0 0" />
    <parent link="Link4" />
    <child link="Link5" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14" upper="3.14" effort="0" velocity="0" />
  </joint>

  <!-- Joint6 -->
  <link name="Link6">
    <inertial>
      <origin xyz="0 0 -0.02053" rpy="0 0 0" />
      <mass value="0.2054" />
      <inertia ixx="0.00011" ixy="0" ixz="0" iyy="0.000111" iyz="0.000000369" izz="0.000205" />
    </inertial>
    <visual><geometry><mesh filename="package://dobot_description/meshes/cr10/Link6.STL" /></geometry></visual>
    <collision><geometry><mesh filename="package://dobot_description/meshes/cr10/Link6.STL" /></geometry></collision>
  </link>
  <joint name="joint6" type="revolute">
    <origin xyz="0 0.1084 0" rpy="-1.5708 0 0" />
    <parent link="Link5" />
    <child link="Link6" />
    <axis xyz="0 0 1" />
    <limit lower="-6.28" upper="6.28" effort="0" velocity="0" />
  </joint>

  </xacro:macro> <!-- 现在和宏匹配了 -->
</robot>
